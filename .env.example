LEARNING_VAULT_PORT=3000
LEARNING_VAULT_HOST=0.0.0.0
LEARNING_VAULT_PUBLIC_URL=https://learning-vault.example.com
LEARNING_VAULT_STORE_PATH=/var/lib/learning-vault/operational-state.enc
LEARNING_VAULT_STORE_KEY=base64-encoded-32-byte-key
LEARNING_VAULT_OAUTH_ISSUER=https://your-identity-provider.example.com/
LEARNING_VAULT_OAUTH_AUDIENCE=https://learning-vault.example.com/mcp
LEARNING_VAULT_OAUTH_JWKS_URI=https://your-identity-provider.example.com/.well-known/jwks.json
LEARNING_VAULT_OAUTH_AUTHORIZATION_ENDPOINT=https://your-identity-provider.example.com/authorize
LEARNING_VAULT_OAUTH_TOKEN_ENDPOINT=https://your-identity-provider.example.com/oauth/token
LEARNING_VAULT_OAUTH_REGISTRATION_ENDPOINT=https://your-identity-provider.example.com/oidc/register
LEARNING_VAULT_GITHUB_APP_ID=123456
LEARNING_VAULT_GITHUB_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
LEARNING_VAULT_STDIO_LEARNER_ID=private-alpha-learner
