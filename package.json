{
  "name": "learning-coach",
  "version": "3.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "ChatGPT plugin and Learning Vault MCP server for evidence-based learning",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/http/main.ts",
    "start": "node dist/http/main.js",
    "start:stdio": "node dist/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@octokit/auth-app": "^8.1.0",
    "@octokit/rest": "^22.0.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
