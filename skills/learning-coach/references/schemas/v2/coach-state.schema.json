{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SShending/learning-coach/blob/main/skills/learning-coach/references/schemas/v2/coach-state.schema.json",
  "title": "Ask Coach State v2",
  "description": "Authoritative durable advisory memory for Ask Coach. This is not learner mastery/evidence state.",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "vaultId",
    "candidateTopics",
    "crossTopicConnections",
    "advisoryHypotheses",
    "appliedUpdates"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "documentType": { "const": "coach-state" },
    "vaultId": { "type": "string", "minLength": 1 },
    "candidateTopics": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/candidateTopic" }
    },
    "crossTopicConnections": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/crossTopicConnection" }
    },
    "advisoryHypotheses": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/advisoryHypothesis" }
    },
    "appliedUpdates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/appliedUpdate" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "topicIdList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "candidateTopic": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "rationale",
        "relatedTopics",
        "targetCapability",
        "revisitWhen",
        "observedAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["candidate", "recommended", "deferred", "accepted", "dismissed", "superseded"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "relatedTopics": { "$ref": "#/$defs/topicIdList" },
        "targetCapability": { "type": "string", "minLength": 1 },
        "revisitWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "crossTopicConnection": {
      "type": "object",
      "required": [
        "id",
        "type",
        "topicIds",
        "summary",
        "basis",
        "status",
        "observedAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "prerequisite",
            "shared_abstraction",
            "implementation_bridge",
            "transfer_opportunity",
            "shared_bottleneck",
            "knowledge_island"
          ]
        },
        "topicIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["stored", "inferred", "grounded"] },
        "status": { "enum": ["active", "superseded", "dismissed"] },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "advisoryHypothesis": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "rationale",
        "relatedTopics",
        "status",
        "revisitWhen",
        "observedAt",
        "updatedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "relatedTopics": { "$ref": "#/$defs/topicIdList" },
        "status": { "enum": ["working", "supported", "rejected", "superseded"] },
        "revisitWhen": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "appliedUpdate": {
      "type": "object",
      "required": ["updateId", "baseRevision", "appliedAt"],
      "properties": {
        "updateId": { "type": "string", "minLength": 1 },
        "baseRevision": { "type": "string", "minLength": 1 },
        "appliedAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": true
    }
  }
}
