{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SShending/learning-coach/blob/main/references/schemas/learning-strategy.schema.json",
  "title": "Learning Strategy State",
  "description": "Current authoritative cross-Topic learning strategy state.",
  "type": "object",
  "required": ["schemaVersion", "documentType", "vaultId", "observations", "appliedUpdates"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "documentType": { "const": "learning-strategy" },
    "vaultId": { "type": "string", "minLength": 1 },
    "observations": { "type": "array", "items": { "type": "object" } },
    "appliedUpdates": { "type": "object", "additionalProperties": { "$ref": "#/$defs/appliedUpdate" } }
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "appliedUpdate": { "type": "object", "required": ["updateId", "baseRevision", "appliedAt"], "properties": { "updateId": { "type": "string", "minLength": 1 }, "baseRevision": { "type": "string", "minLength": 1 }, "appliedAt": { "$ref": "#/$defs/timestamp" } }, "additionalProperties": true }
  }
}
